<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fu</groupId>
        <artifactId>satori-learning-support-application-backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>start</artifactId>
    <description>Application entry point - Assembles all modules</description>

    <dependencies>
        <!-- Internal Modules -->
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>infrastructure</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>user</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>course</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>class</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>curriculum-import</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>conversation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>pronunciation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>roleplay</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>assignment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>practice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fu</groupId>
            <artifactId>achievement</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- .env file support -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Xms512m -Xmx2g</jvmArguments>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>