@startuml UC-06: Login by Email

actor Learner
participant "Login Screen\n(UI)" as UI
participant AuthController
participant AuthServiceImpl
participant UserRepository
participant PasswordEncoder
participant JwtService
participant UserSessionRepository
participant DeviceDetector
participant Database
participant ExceptionHandler

== Normal Flow ==

Learner -> UI: Nhập Email và Password
activate UI

UI -> UI: Validate email format (BR-47, BR-48, BR-49)
UI -> UI: Enable "Đăng nhập" button (BR-46)

Learner -> UI: Tap "Đăng nhập" button
UI -> AuthController: POST /api/v1/auth/login\n(LoginRequest, ipAddress, userAgent)
activate AuthController

AuthController -> AuthServiceImpl: login(request, ipAddress, userAgent)
activate AuthServiceImpl

AuthServiceImpl -> UserRepository: findByEmail(email)
activate UserRepository
UserRepository -> Database: SELECT * FROM users WHERE email = ?
activate Database
Database --> UserRepository: User data
deactivate Database
UserRepository --> AuthServiceImpl: Optional<User>
deactivate UserRepository

alt E2: User not found
    AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("INVALID_CREDENTIALS")
    activate ExceptionHandler
    ExceptionHandler --> AuthController: 400 Bad Request\n(MSG13: "Sai email hoặc mật khẩu")
    deactivate ExceptionHandler
    AuthController --> UI: Error Response
    UI --> Learner: Hiển thị MSG13
    deactivate AuthServiceImpl
    deactivate AuthController
    deactivate UI
else User found

    AuthServiceImpl -> AuthServiceImpl: Check if deleted
    alt Account deleted
        AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("ACCOUNT_DELETED")
        activate ExceptionHandler
        ExceptionHandler --> AuthController: 400 Bad Request
        deactivate ExceptionHandler
        AuthController --> UI: Error Response
        UI --> Learner: "Tài khoản không tồn tại"
        deactivate AuthServiceImpl
        deactivate AuthController
        deactivate UI
    end

    AuthServiceImpl -> AuthServiceImpl: Check status == SUSPENDED (BR-51)
    alt E3: Account suspended
        AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("ACCOUNT_SUSPENDED")
        activate ExceptionHandler
        ExceptionHandler --> AuthController: 403 Forbidden\n(MSG21)
        deactivate ExceptionHandler
        AuthController --> UI: Error Response
        UI --> Learner: Hiển thị MSG21:\n"Tài khoản đã bị chặn"
        deactivate AuthServiceImpl
        deactivate AuthController
        deactivate UI
    end

    AuthServiceImpl -> AuthServiceImpl: Check status == PENDING_ACTIVATION
    alt Account not activated
        AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("ACCOUNT_NOT_ACTIVATED")
        activate ExceptionHandler
        ExceptionHandler --> AuthController: 400 Bad Request
        deactivate ExceptionHandler
        AuthController --> UI: Error Response
        UI --> Learner: "Tài khoản chưa kích hoạt"
        deactivate AuthServiceImpl
        deactivate AuthController
        deactivate UI
    end

    AuthServiceImpl -> AuthServiceImpl: Check if locked (lockedUntil)
    alt Account locked
        AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("ACCOUNT_LOCKED")
        activate ExceptionHandler
        ExceptionHandler --> AuthController: 403 Forbidden
        deactivate ExceptionHandler
        AuthController --> UI: Error Response
        UI --> Learner: "Tài khoản bị khóa tạm thời"
        deactivate AuthServiceImpl
        deactivate AuthController
        deactivate UI
    end

    AuthServiceImpl -> PasswordEncoder: matches(rawPassword, hashedPassword)
    activate PasswordEncoder
    PasswordEncoder --> AuthServiceImpl: boolean (BR-50)
    deactivate PasswordEncoder

    alt E2: Wrong password
        AuthServiceImpl -> AuthServiceImpl: handleFailedLogin(user)
        AuthServiceImpl -> UserRepository: save(user)\n(increment failedLoginAttempts)
        activate UserRepository
        UserRepository -> Database: UPDATE users SET failed_login_attempts = ?
        activate Database
        Database --> UserRepository: Success
        deactivate Database
        deactivate UserRepository

        AuthServiceImpl -> ExceptionHandler: throw BusinessException\n("INVALID_CREDENTIALS")
        activate ExceptionHandler
        ExceptionHandler --> AuthController: 400 Bad Request\n(MSG13)
        deactivate ExceptionHandler
        AuthController --> UI: Error Response
        UI --> Learner: Hiển thị MSG13:\n"Sai email hoặc mật khẩu"
        deactivate AuthServiceImpl
        deactivate AuthController
        deactivate UI
    else Password correct

        AuthServiceImpl -> AuthServiceImpl: Reset failed attempts\nUpdate lastLoginAt
        AuthServiceImpl -> UserRepository: save(user)
        activate UserRepository
        UserRepository -> Database: UPDATE users SET\nfailed_login_attempts = 0,\nlast_login_at = NOW()
        activate Database
        Database --> UserRepository: Success
        deactivate Database
        deactivate UserRepository

        AuthServiceImpl -> AuthServiceImpl: createSessionAndGenerateTokens()

        AuthServiceImpl -> DeviceDetector: detectDevice(userAgent, deviceInfo)
        activate DeviceDetector
        DeviceDetector --> AuthServiceImpl: Map<String, Object>
        deactivate DeviceDetector

        AuthServiceImpl -> UserSessionRepository: save(UserSession)
        activate UserSessionRepository
        UserSessionRepository -> Database: INSERT INTO user_sessions\n(user_id, device_info, ip_address...)
        activate Database
        Database --> UserSessionRepository: UserSession saved
        deactivate Database
        UserSessionRepository --> AuthServiceImpl: UserSession
        deactivate UserSessionRepository

        AuthServiceImpl -> JwtService: generateAccessToken(user, sessionId)
        activate JwtService
        note right: BR-52: Valid 30 minutes
        JwtService --> AuthServiceImpl: accessToken
        deactivate JwtService

        AuthServiceImpl -> JwtService: generateRefreshToken(sessionId)
        activate JwtService
        note right: BR-52: Valid 1 week
        JwtService --> AuthServiceImpl: refreshToken
        deactivate JwtService

        AuthServiceImpl -> UserSessionRepository: save(session)\n(update refreshToken)
        activate UserSessionRepository
        UserSessionRepository -> Database: UPDATE user_sessions\nSET refresh_token = ?
        activate Database
        Database --> UserSessionRepository: Success
        deactivate Database
        deactivate UserSessionRepository

        AuthServiceImpl --> AuthController: LoginResponse\n(POST-1: tokens stored)
        deactivate AuthServiceImpl

        AuthController --> UI: 200 OK\n(accessToken, refreshToken, user info)
        deactivate AuthController

        UI -> UI: Store tokens locally (POST-1)
        UI --> Learner: Redirect to Home Screen (POST-2)
        deactivate UI

    end
end

@enduml
